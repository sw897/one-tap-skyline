{$GAME_HOST} {
    encode zstd gzip
    @game path /{$GAME_ID} /{$GAME_ID}/*
    handle @game {
        reverse_proxy {$GAME_ID}-backend:8080 {
            header_up X-Skyline-Client-IP {remote_host}
            header_up -CF-Connecting-IP
        }
    }
    handle {
        header Cache-Control no-store
        respond 404
    }
}
