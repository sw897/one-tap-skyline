{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx", "esModuleInterop": true, "allowJs": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "app", "db", "build", "lib", "vite.config.ts", "drizzle.config.ts", "cloudflare-env.d.ts", "tests/**/*.test.ts"]
}
