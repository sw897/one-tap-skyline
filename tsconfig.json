{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "node-web",
    "db",
    "build",
    "vite.config.ts",
    "drizzle.config.ts",
    "tests/**/*.test.ts"
  ]
}
